# AI Infrastructure Transmission Map — Environment Variables
# Copy to .env and fill in your values.
# All AI keys are optional — the app runs with stub/mock responses without them.

# ── FREE Gemini API (primary LLM — get key at aistudio.google.com) ───────────
GEMINI_API_KEY=your-gemini-api-key-here     # FREE at aistudio.google.com
GOOGLE_API_KEY=your-gemini-api-key-here     # Same key works for both vars

# ── Optional paid fallbacks (comment out if not needed) ──────────────────────
# ANTHROPIC_API_KEY=optional-paid-fallback     # Claude Opus (optional)
# OPENAI_API_KEY=optional-paid-fallback        # Whisper (replaced by Gemini audio)

# ── Google Cloud / BigQuery (optional — SQLite fallback if not set) ───────────
BIGQUERY_PROJECT_ID=your-project-id      # Optional: leave blank to use SQLite
BIGQUERY_DATASET=ai_transmission_map     # Optional
BIGQUERY_CREDENTIALS_PATH=              # Optional: path to service account JSON
GOOGLE_CLOUD_PROJECT=your-project-id    # Alias used by google-cloud SDK

# ── API Auth ──────────────────────────────────────────────────────────────────
AITM_API_KEY=dev-key-change-in-production  # Auth for write endpoints (X-Api-Key header)

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000   # Frontend → backend URL
NEXT_PUBLIC_API_KEY=dev-key-change-in-production
